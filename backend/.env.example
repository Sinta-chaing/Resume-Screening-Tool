# Copy to .env and adjust per environment.
# !!! NEVER commit .env with real secrets !!!

# Production hosting requires a real SECRET_KEY. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-a-long-random-string

# DEBUG must be False in production.
DEBUG=False

# Comma-separated hostnames that may serve this API.
# Examples: api.example.com, example.com, 143.198.10.20
ALLOWED_HOSTS=api.example.com,127.0.0.1

# --- Ollama (LLM embedding + chat server) ---
USE_OLLAMA=true
# Point to where Ollama runs (same host or a dedicated LLM box).
OLLAMA_BASE_URL=http://localhost:11434
# Embedding dimension must match ResumeChunk.embedding VectorField (1024 dims).
# mxbai-embed-large = 1024 dims (current schema default).
EMBEDDING_MODEL=mxbai-embed-large
# Chat model writes the report prose + answers RAG chat questions. On a small
# CPU-only VPS use the fast 1b model (scores are computed by the deterministic
# scorer, NOT this model). Scale up to llama3.2:3b for higher prose quality.
CHAT_MODEL=qwen2.5:0.5b
# How long Ollama keeps each model loaded in RAM. The 3.7GB box can't hold
# BOTH models at once, so they stay loaded only for their own phase:
#   OLLAMA_EMBED_KEEP_ALIVE=60s  -> embed model evicts before chat model loads
#   OLLAMA_CHAT_KEEP_ALIVE=5m    -> covers the 3 report calls, evicts after
# Raise OLLAMA_KEEP_ALIVE to override both. Use "0" to unload after every call.
OLLAMA_EMBED_KEEP_ALIVE=60s
OLLAMA_CHAT_KEEP_ALIVE=5m

# --- CORS (which frontend origins may call this API) ---
# Option A: allow any origin (bad for prod with auth; fine for internal tools)
CORS_ALLOW_ALL=false
# Option B: explicit list
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com,http://localhost:3000

# --- PostgreSQL (must have pgvector extension installed) ---
# Enable vector extension in the target DB:
#   CREATE EXTENSION IF NOT EXISTS vector;
DB_NAME=resume_screener
DB_USER=postgres
DB_PASSWORD=strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432