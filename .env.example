# Copy to .env and adjust per environment.
# !!! NEVER commit .env with real secrets !!!

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
# Domains that may serve this API (Cloudflare-tunneled domain + local access).
ALLOWED_HOSTS=datasciences.engineer,localhost,127.0.0.1

# --- PostgreSQL (pgvector image bundles the vector extension) ---
DB_NAME=resume_screener
DB_USER=postgres
DB_PASSWORD=replace-with-strong-password

# --- Ollama (container service name, reachable only inside the compose network) ---
USE_OLLAMA=true
OLLAMA_BASE_URL=http://ollama:11434
# mxbai-embed-large = 1024 dims (matches ResumeChunk.embedding VectorField).
EMBEDDING_MODEL=mxbai-embed-large
# More powerful chat model for the 12GB server: writes better report prose and
# RAG answers. Scores come from the deterministic scorer, NOT this model, so it
# only affects prose quality and generation time.
CHAT_MODEL=llama3.2:3b
# Keep Ollama models loaded so consecutive jobs skip the (expensive) reload.
OLLAMA_EMBED_KEEP_ALIVE=10m
OLLAMA_CHAT_KEEP_ALIVE=10m

# --- CORS (which frontend origins may call this API) ---
# Option A: allow any origin (bad for prod with auth; fine for internal tools)
CORS_ALLOW_ALL=false
# Option B: explicit list
CORS_ALLOWED_ORIGINS=

# --- Cloudflare Tunnel ---
# Create the tunnel first in Cloudflare Zero Trust -> Networks -> Tunnels,
# then put its token here and start the cloudflared service:
#   docker compose up -d cloudflared
CLOUDFLARE_TUNNEL_TOKEN=